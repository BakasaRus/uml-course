@startuml
!$ARROW_COLOR = "#94A3B8"
!$ARROW_FONT_COLOR = "#E2E8F0"
!$BOUNDARY_COLOR = "#CBD5E1"
!$LEGEND_TITLE_COLOR = "#E2E8F0"
!$LEGEND_FONT_COLOR = "#E2E8F0"
!$LEGEND_DARK_COLOR = "#E2E8F0"
!$LEGEND_LIGHT_COLOR = "#0F172A"
!include <C4/C4_Container>
skinparam TitleFontColor #E2E8F0
skinparam backgroundColor #0F172A
LAYOUT_TOP_DOWN()
title Контейнеры — сервис записи на консультации

System_Ext(sso, "Служба единого входа", "Проверяет личность")
System_Ext(notice, "Сервис уведомлений", "Доставляет подтверждения")
System_Boundary(booking, "Сервис записи на консультации") {
  Container(web, "Веб-приложение", "Браузер / HTTPS", "Даёт студенту и преподавателю интерфейс записи")
  Container(api, "Серверное приложение", "Прикладной интерфейс", "Проверяет и сохраняет записи")
  ContainerDb(db, "База данных", "Реляционная БД", "Хранит расписание и записи")
  Container(worker, "Обработчик уведомлений", "Фоновая задача", "Передаёт подтверждения")
}

Rel(web, api, "Передаёт запросы")
Rel(api, db, "Читает и сохраняет")
Rel(api, worker, "Публикует событие")
Rel(api, sso, "Проверяет личность")
Rel(worker, notice, "Передаёт сообщение")
SHOW_LEGEND()
@enduml
