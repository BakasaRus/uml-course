@startuml
!$ARROW_COLOR = "#94A3B8"
!$ARROW_FONT_COLOR = "#E2E8F0"
!$BOUNDARY_COLOR = "#CBD5E1"
!$LEGEND_TITLE_COLOR = "#E2E8F0"
!$LEGEND_FONT_COLOR = "#E2E8F0"
!$LEGEND_DARK_COLOR = "#E2E8F0"
!$LEGEND_LIGHT_COLOR = "#0F172A"
!include <C4/C4_Context>
skinparam TitleFontColor #E2E8F0
skinparam backgroundColor #0F172A
LAYOUT_TOP_DOWN()
title Контекст системы — сервис записи на консультации

Person(student, "Студент", "Выбирает свободный интервал и создаёт запись")
Person(teacher, "Преподаватель", "Открывает интервалы для консультаций")
Person(office, "Сотрудник учебного офиса", "Разрешает спорные записи")
System(booking, "Сервис записи на консультации", "Запись студентов на консультации")
System_Ext(sso, "Служба единого входа", "Проверяет личность пользователя")
System_Ext(notice, "Сервис уведомлений", "Доставляет подтверждения")

Rel(student, booking, "Записывается на консультацию")
Rel(teacher, booking, "Открывает интервалы")
Rel(office, booking, "Разрешает спорные записи")
Rel(booking, sso, "Проверяет личность")
Rel(booking, notice, "Передаёт события")
SHOW_LEGEND()
@enduml
