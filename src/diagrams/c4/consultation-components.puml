@startuml
!$ARROW_COLOR = "#94A3B8"
!$ARROW_FONT_COLOR = "#E2E8F0"
!$BOUNDARY_COLOR = "#CBD5E1"
!$LEGEND_TITLE_COLOR = "#E2E8F0"
!$LEGEND_FONT_COLOR = "#E2E8F0"
!$LEGEND_DARK_COLOR = "#E2E8F0"
!$LEGEND_LIGHT_COLOR = "#0F172A"
!include <C4/C4_Component>
skinparam TitleFontColor #E2E8F0
skinparam backgroundColor #0F172A
LAYOUT_TOP_DOWN()
title Компоненты — серверное приложение записи

System_Ext(sso, "Служба единого входа", "Проверяет личность")
System_Ext(notice, "Сервис уведомлений", "Доставляет подтверждения")
Container_Boundary(api, "Серверное приложение") {
  Component(endpoint, "Прикладной интерфейс записи", "HTTP API", "Принимает запросы")
  Component(booking, "Служба записи", "Сервис предметной области", "Создаёт и отменяет записи")
  ComponentDb(repository, "Хранилище записей", "Репозиторий", "Хранит записи и расписание")
  Component(adapter, "Адаптер единого входа", "Клиент SSO", "Проверяет личность")
  Component(notification, "Компонент уведомлений", "Издатель событий", "Передаёт подтверждение")
}

Rel(endpoint, booking, "Вызывает")
Rel(booking, repository, "Сохраняет запись")
Rel(booking, adapter, "Проверяет личность")
Rel(booking, notification, "Публикует событие")
Rel(adapter, sso, "Проверяет личность")
Rel(notification, notice, "Передаёт сообщение")
SHOW_LEGEND()
@enduml
